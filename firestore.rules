rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerifiedUser()
        && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || request.auth.token.email == 'qbotmanager@gmail.com'
        );
    }

    // --- Entity Validation Blueprints ---
    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'country', 'themePreference', 'soundEnabled', 'voiceCoachEnabled', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && (!('country' in data) || (data.country is string && data.country.size() >= 2 && data.country.size() <= 64))
        && (!('themePreference' in data) || data.themePreference in ['dark', 'light'])
        && (!('soundEnabled' in data) || data.soundEnabled is bool)
        && (!('voiceCoachEnabled' in data) || data.voiceCoachEnabled is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlayerProfile(data) {
      return data.keys().hasAll(['uid', 'username', 'eloEnglish', 'eloInternational', 'eloCustom', 'xp', 'level', 'totalGames', 'wins', 'draws', 'losses', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'avatarUrl', 'country', 'eloEnglish', 'eloInternational', 'eloCustom', 'peakElo', 'xp', 'level', 'totalGames', 'wins', 'draws', 'losses', 'favoriteVariant', 'badges', 'unlockedThemes', 'selectedBoardTheme', 'selectedPieceTheme', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 32
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 512))
        && (!('country' in data) || (data.country is string && data.country.size() >= 2 && data.country.size() <= 64))
        && data.eloEnglish is number && data.eloEnglish >= 100 && data.eloEnglish <= 4000
        && data.eloInternational is number && data.eloInternational >= 100 && data.eloInternational <= 4000
        && data.eloCustom is number && data.eloCustom >= 100 && data.eloCustom <= 4000
        && (!('peakElo' in data) || (data.peakElo is number && data.peakElo >= 100 && data.peakElo <= 4000))
        && data.xp is number && data.xp >= 0 && data.xp <= 10000000
        && data.level is number && data.level >= 1 && data.level <= 500
        && data.totalGames is number && data.totalGames >= 0 && data.totalGames <= 1000000
        && data.wins is number && data.wins >= 0 && data.wins <= 1000000
        && data.draws is number && data.draws >= 0 && data.draws <= 1000000
        && data.losses is number && data.losses >= 0 && data.losses <= 1000000
        && (!('favoriteVariant' in data) || data.favoriteVariant in ['draft_master_8x8', 'english_8x8', 'international_10x10', 'custom'])
        && (!('badges' in data) || (data.badges is list && data.badges.size() <= 50 && (data.badges.size() == 0 || (data.badges[0] is string && data.badges[0].size() <= 64))))
        && (!('unlockedThemes' in data) || (data.unlockedThemes is list && data.unlockedThemes.size() <= 30 && (data.unlockedThemes.size() == 0 || (data.unlockedThemes[0] is string && data.unlockedThemes[0].size() <= 40))))
        && (!('selectedBoardTheme' in data) || (data.selectedBoardTheme is string && data.selectedBoardTheme.size() <= 40))
        && (!('selectedPieceTheme' in data) || (data.selectedPieceTheme is string && data.selectedPieceTheme.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['matchId', 'mode', 'variantPreset', 'rulesConfig', 'whitePlayerId', 'whitePlayerName', 'status', 'turn', 'boardCompressed', 'moveCount', 'winnerSide', 'isPrivate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['matchId', 'mode', 'variantPreset', 'rulesConfig', 'whitePlayerId', 'whitePlayerName', 'blackPlayerId', 'blackPlayerName', 'status', 'turn', 'boardCompressed', 'moveCount', 'winnerSide', 'resultReason', 'roomCode', 'isPrivate', 'timeControlSeconds', 'drawOfferBy', 'createdAt', 'updatedAt'])
        && isValidId(data.matchId)
        && data.mode in ['realtime', 'turn_based', 'league', 'tournament']
        && data.variantPreset in ['draft_master_8x8', 'english_8x8', 'international_10x10', 'custom']
        && data.rulesConfig is map
        && isValidId(data.whitePlayerId)
        && data.whitePlayerName is string && data.whitePlayerName.size() >= 1 && data.whitePlayerName.size() <= 40
        && (!('blackPlayerId' in data) || (data.blackPlayerId is string && data.blackPlayerId.size() <= 128))
        && (!('blackPlayerName' in data) || (data.blackPlayerName is string && data.blackPlayerName.size() <= 40))
        && data.status in ['waiting', 'active', 'completed', 'aborted']
        && data.turn in ['white', 'black']
        && data.boardCompressed is string && data.boardCompressed.size() >= 16 && data.boardCompressed.size() <= 256
        && data.moveCount is number && data.moveCount >= 0 && data.moveCount <= 2000
        && data.winnerSide in ['white', 'black', 'draw', 'none']
        && (!('resultReason' in data) || (data.resultReason is string && data.resultReason.size() <= 64))
        && (!('roomCode' in data) || (data.roomCode is string && data.roomCode.size() <= 16))
        && data.isPrivate is bool
        && (!('timeControlSeconds' in data) || (data.timeControlSeconds is number && data.timeControlSeconds >= 0 && data.timeControlSeconds <= 604800))
        && (!('drawOfferBy' in data) || data.drawOfferBy in ['white', 'black', 'none'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMatchMove(data, matchId) {
      return data.keys().hasAll(['moveId', 'matchId', 'ply', 'playerId', 'whitePlayerId', 'blackPlayerId', 'notation', 'boardCompressed', 'createdAt'])
        && data.keys().hasOnly(['moveId', 'matchId', 'ply', 'playerId', 'whitePlayerId', 'blackPlayerId', 'notation', 'boardCompressed', 'createdAt'])
        && isValidId(data.moveId)
        && data.matchId == matchId
        && data.ply is number && data.ply >= 1 && data.ply <= 2000
        && isValidId(data.playerId)
        && isValidId(data.whitePlayerId)
        && isValidId(data.blackPlayerId)
        && data.playerId == request.auth.uid
        && data.notation is string && data.notation.size() >= 3 && data.notation.size() <= 64
        && data.boardCompressed is string && data.boardCompressed.size() >= 16 && data.boardCompressed.size() <= 256
        && data.createdAt is timestamp;
    }

    function isValidLeague(data) {
      return data.keys().hasAll(['leagueId', 'name', 'visibility', 'ownerId', 'ownerName', 'variantPreset', 'rulesConfig', 'format', 'maxMembers', 'memberCount', 'winPoints', 'drawPoints', 'lossPoints', 'status', 'seasonNumber', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['leagueId', 'name', 'description', 'visibility', 'inviteCode', 'ownerId', 'ownerName', 'variantPreset', 'rulesConfig', 'format', 'maxMembers', 'memberCount', 'winPoints', 'drawPoints', 'lossPoints', 'status', 'seasonNumber', 'announcement', 'createdAt', 'updatedAt'])
        && isValidId(data.leagueId)
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 64
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && data.visibility in ['public', 'private']
        && (!('inviteCode' in data) || (data.inviteCode is string && data.inviteCode.size() <= 16))
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 40
        && data.variantPreset in ['draft_master_8x8', 'english_8x8', 'international_10x10', 'custom']
        && data.rulesConfig is map
        && data.format in ['round_robin', 'knockout']
        && data.maxMembers is number && data.maxMembers >= 2 && data.maxMembers <= 256
        && data.memberCount is number && data.memberCount >= 1 && data.memberCount <= 256
        && data.winPoints is number && data.winPoints >= 0 && data.winPoints <= 10
        && data.drawPoints is number && data.drawPoints >= 0 && data.drawPoints <= 10
        && data.lossPoints is number && data.lossPoints >= 0 && data.lossPoints <= 10
        && data.status in ['open', 'active', 'completed']
        && data.seasonNumber is number && data.seasonNumber >= 1 && data.seasonNumber <= 100
        && (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeagueMember(data, leagueId) {
      return data.keys().hasAll(['memberId', 'leagueId', 'userId', 'username', 'role', 'status', 'played', 'wins', 'draws', 'losses', 'points', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['memberId', 'leagueId', 'userId', 'username', 'role', 'status', 'played', 'wins', 'draws', 'losses', 'points', 'joinedAt', 'updatedAt'])
        && isValidId(data.memberId)
        && data.leagueId == leagueId
        && isValidId(data.userId)
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 40
        && data.role in ['owner', 'admin', 'member']
        && data.status in ['pending', 'approved', 'removed']
        && data.played is number && data.played >= 0 && data.played <= 1000
        && data.wins is number && data.wins >= 0 && data.wins <= 1000
        && data.draws is number && data.draws >= 0 && data.draws <= 1000
        && data.losses is number && data.losses >= 0 && data.losses <= 1000
        && data.points is number && data.points >= 0 && data.points <= 10000
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTournament(data) {
      return data.keys().hasAll(['tournamentId', 'name', 'ownerId', 'ownerName', 'variantPreset', 'rulesConfig', 'format', 'maxParticipants', 'participantCount', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tournamentId', 'name', 'description', 'ownerId', 'ownerName', 'variantPreset', 'rulesConfig', 'format', 'maxParticipants', 'participantCount', 'status', 'championId', 'championName', 'createdAt', 'updatedAt'])
        && isValidId(data.tournamentId)
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 64
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 40
        && data.variantPreset in ['draft_master_8x8', 'english_8x8', 'international_10x10', 'custom']
        && data.rulesConfig is map
        && data.format in ['single_elimination', 'round_robin']
        && data.maxParticipants is number && data.maxParticipants >= 2 && data.maxParticipants <= 128
        && data.participantCount is number && data.participantCount >= 0 && data.participantCount <= 128
        && data.status in ['registration', 'in_progress', 'completed']
        && (!('championId' in data) || (data.championId is string && data.championId.size() <= 128))
        && (!('championName' in data) || (data.championName is string && data.championName.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTournamentEntry(data, tournamentId) {
      return data.keys().hasAll(['entryId', 'tournamentId', 'userId', 'username', 'seed', 'elo', 'eliminated', 'joinedAt'])
        && data.keys().hasOnly(['entryId', 'tournamentId', 'userId', 'username', 'seed', 'elo', 'eliminated', 'joinedAt'])
        && isValidId(data.entryId)
        && data.tournamentId == tournamentId
        && isValidId(data.userId)
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 40
        && data.seed is number && data.seed >= 1 && data.seed <= 128
        && data.elo is number && data.elo >= 100 && data.elo <= 4000
        && data.eliminated is bool
        && data.joinedAt is timestamp;
    }

    // --- Collection Rules ---

    // Private PII users doc
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserPrivate(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserPrivate(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'country', 'themePreference', 'soundEnabled', 'voiceCoachEnabled', 'updatedAt']);
      allow delete: if false;
    }

    // Public competitive player profile (zero PII)
    match /player_profiles/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(userId) && isOwner(userId) && isValidPlayerProfile(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId) && isValidPlayerProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'avatarUrl', 'country', 'eloEnglish', 'eloInternational', 'eloCustom', 'peakElo', 'xp', 'level', 'totalGames', 'wins', 'draws', 'losses', 'favoriteVariant', 'badges', 'unlockedThemes', 'selectedBoardTheme', 'selectedPieceTheme', 'updatedAt']);
      allow delete: if false;
    }

    // Online matches
    match /matches/{matchId} {
      allow get: if isValidId(matchId) && isSignedIn() && (
        existing().status == 'waiting'
        || existing().whitePlayerId == request.auth.uid
        || existing().blackPlayerId == request.auth.uid
        || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.status == 'waiting'
        || resource.data.whitePlayerId == request.auth.uid
        || resource.data.blackPlayerId == request.auth.uid
      );
      allow create: if isValidId(matchId) && isVerifiedUser() && isValidMatch(incoming())
        && incoming().matchId == matchId
        && incoming().whitePlayerId == request.auth.uid
        && incoming().status == 'waiting'
        && incoming().moveCount == 0
        && incoming().winnerSide == 'none'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(matchId) && isVerifiedUser() && isValidMatch(incoming())
        && existing().status in ['waiting', 'active']
        && incoming().matchId == existing().matchId
        && incoming().whitePlayerId == existing().whitePlayerId
        && incoming().mode == existing().mode
        && incoming().variantPreset == existing().variantPreset
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().status == 'waiting'
            && existing().whitePlayerId != request.auth.uid
            && incoming().blackPlayerId == request.auth.uid
            && incoming().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['blackPlayerId', 'blackPlayerName', 'status', 'updatedAt'])
          )
          || (
            existing().status == 'active'
            && (existing().whitePlayerId == request.auth.uid || existing().blackPlayerId == request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['boardCompressed', 'turn', 'moveCount', 'status', 'winnerSide', 'resultReason', 'drawOfferBy', 'updatedAt'])
          )
        );
      allow delete: if false;

      match /moves/{moveId} {
        allow get: if isValidId(matchId) && isValidId(moveId) && isSignedIn() && (
          existing().whitePlayerId == request.auth.uid
          || existing().blackPlayerId == request.auth.uid
        );
        allow list: if isValidId(matchId) && isSignedIn() && (
          resource.data.whitePlayerId == request.auth.uid
          || resource.data.blackPlayerId == request.auth.uid
        );
        allow create: if isValidId(matchId) && isValidId(moveId) && isVerifiedUser()
          && isValidMatchMove(incoming(), matchId)
          && incoming().moveId == moveId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/matches/$(matchId))
          && (
            (get(/databases/$(database)/documents/matches/$(matchId)).data.whitePlayerId == incoming().whitePlayerId
              && get(/databases/$(database)/documents/matches/$(matchId)).data.blackPlayerId == incoming().blackPlayerId)
            && (incoming().whitePlayerId == request.auth.uid || incoming().blackPlayerId == request.auth.uid)
          );
        allow update, delete: if false;
      }
    }

    // Competitive Leagues
    match /leagues/{leagueId} {
      allow get: if isValidId(leagueId) && isSignedIn() && (
        existing().visibility == 'public'
        || existing().ownerId == request.auth.uid
        || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.visibility == 'public'
        || resource.data.ownerId == request.auth.uid
      );
      allow create: if isValidId(leagueId) && isVerifiedUser() && isValidLeague(incoming())
        && incoming().leagueId == leagueId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(leagueId) && isVerifiedUser() && isValidLeague(incoming())
        && incoming().leagueId == existing().leagueId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'status', 'seasonNumber', 'announcement', 'memberCount', 'updatedAt'])
          )
          || (
            existing().visibility == 'public'
            && incoming().memberCount == existing().memberCount + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
          )
        );
      allow delete: if false;

      match /members/{memberId} {
        allow get: if isValidId(leagueId) && isValidId(memberId) && isSignedIn() && exists(/databases/$(database)/documents/leagues/$(leagueId));
        allow list: if isValidId(leagueId) && isSignedIn() && resource.data.leagueId == leagueId;
        allow create: if isValidId(leagueId) && isValidId(memberId) && isVerifiedUser()
          && isValidLeagueMember(incoming(), leagueId)
          && incoming().memberId == memberId
          && incoming().userId == request.auth.uid
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/leagues/$(leagueId));
        allow update: if isValidId(leagueId) && isValidId(memberId) && isVerifiedUser()
          && isValidLeagueMember(incoming(), leagueId)
          && incoming().memberId == existing().memberId
          && incoming().leagueId == existing().leagueId
          && incoming().userId == existing().userId
          && incoming().joinedAt == existing().joinedAt
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || get(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerId == request.auth.uid
          )
          && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'played', 'wins', 'draws', 'losses', 'points', 'updatedAt']);
        allow delete: if false;
      }
    }

    // Competitive Tournaments
    match /tournaments/{tournamentId} {
      allow get: if isValidId(tournamentId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(tournamentId) && isVerifiedUser() && isValidTournament(incoming())
        && incoming().tournamentId == tournamentId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(tournamentId) && isVerifiedUser() && isValidTournament(incoming())
        && existing().status != 'completed'
        && incoming().tournamentId == existing().tournamentId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'participantCount', 'championId', 'championName', 'updatedAt'])
          )
          || (
            existing().status == 'registration'
            && incoming().participantCount == existing().participantCount + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['participantCount', 'updatedAt'])
          )
        );
      allow delete: if false;

      match /entries/{entryId} {
        allow get: if isValidId(tournamentId) && isValidId(entryId) && isSignedIn();
        allow list: if isValidId(tournamentId) && isSignedIn() && resource.data.tournamentId == tournamentId;
        allow create: if isValidId(tournamentId) && isValidId(entryId) && isVerifiedUser()
          && isValidTournamentEntry(incoming(), tournamentId)
          && incoming().entryId == entryId
          && incoming().userId == request.auth.uid
          && incoming().joinedAt == request.time
          && exists(/databases/$(database)/documents/tournaments/$(tournamentId));
        allow update: if isValidId(tournamentId) && isValidId(entryId) && isVerifiedUser()
          && isValidTournamentEntry(incoming(), tournamentId)
          && incoming().entryId == existing().entryId
          && incoming().tournamentId == existing().tournamentId
          && incoming().userId == existing().userId
          && incoming().joinedAt == existing().joinedAt
          && (
            isAdmin()
            || get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId == request.auth.uid
          )
          && incoming().diff(existing()).affectedKeys().hasOnly(['seed', 'eliminated']);
        allow delete: if false;
      }
    }

    // Connection test path (read-only/health)
    match /test/connection {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Admin registry (read-only)
    match /admins/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list, write: if false;
    }
  }
}
